{
  "name": "ledger",
  "version": "1.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "bun run --filter @ledger/api start",
    "lint": "oxlint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.80.0",
    "oxlint": "^1.90.0",
    "turbo": "^2.10.0",
    "typescript": "~7.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.9"
  },
  "packageManager": "bun@1.3.14"
}
