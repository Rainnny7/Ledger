{
  "name": "ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"bun run dev:api\" \"bun run dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "test": "bun test server src",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/node-server": "^2.1.11",
    "@tailwindcss/vite": "^4.3.5",
    "@takumi-rs/helpers": "^2.22.1",
    "@tanstack/react-query": "^5.108.4",
    "better-auth": "^1.7.27",
    "boneyard-js": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.21",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.79.0",
    "motion": "^14.14.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.3",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "takumi-pdf": "^0.21.3",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.2.2",
    "uqr": "0.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.90.0",
    "rollup-plugin-visualizer": "^7.3.0",
    "shadcn": "^4.23.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "overrides": {
    "minimatch": "^11.0.9"
  },
  "packageManager": "bun@1.3.14"
}
