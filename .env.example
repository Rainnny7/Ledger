# Copy to .env and adjust. Every value is optional.

# API port (the Vite dev server proxies /api to it)
PORT=3001

# Public origin of the web app (Better Auth trusted origin)
APP_URL=http://localhost:5173

# Signs sessions and encrypts saved bank credentials. If unset, one is generated
# into $DATA_DIR/.secret on first run. Changing it logs everyone out and makes
# saved credentials unreadable.
# Generate one with: openssl rand -hex 32
# APP_SECRET=

# Where the SQLite database and encrypted sessions live
# DATA_DIR=/absolute/path/to/data   (defaults to ./data in the repo root)

# Set to false to watch the browser sign in to EasyWeb
TD_HEADLESS=true

# Use an installed browser instead of Playwright's Chromium, e.g. chrome or msedge
# TD_BROWSER_CHANNEL=

# Whether sign-ups start open after the first account. Admins can flip this later in Admin → Sign-ups.
ALLOW_REGISTRATION=false

# Behind a reverse proxy: true or 1 = one trusted hop, or a hop count (e.g. 2). Unset/false = socket
# address only (clients cannot spoof X-Forwarded-For on /api).
# TRUST_PROXY=false

# How many daily database backups to keep in $DATA_DIR/backups
# BACKUPS_KEPT=14

# Live exchange rates for converting totals into each person's currency (Coinbase-compatible API).
# Set it to `off` to use only the ECB's daily rates below.
# FX_LIVE_URL=https://api.coinbase.com/v2/exchange-rates?currency=USD
# Fallback when live rates fail: daily ECB reference rates (any Frankfurter-compatible API)
# FX_RATES_URL=https://api.frankfurter.dev/v1/latest

# live (default) or sandbox, for testing the PayPal connection against PayPal's sandbox
# PAYPAL_ENV=live

# Address used in invoice share links and PayPal webhooks. Must be public https for webhooks.
# PUBLIC_URL=https://ledger.example.com

# Extra hostnames the Vite dev server answers on, comma-separated (a tunnel or LAN name)
# ALLOWED_HOSTS=ledger.example.com

# Skeleton capture (boneyard-js). Paste the value of the `better-auth.session_token` cookie from a
# signed-in dev session; `bun run dev` then captures skeletons into apps/web/src/bones/ as you edit pages.
# BONEYARD_SESSION_TOKEN=

# Set to false to stop checking for new releases.
# UPDATE_CHECK=false

# docker or source (default): which upgrade commands the Admin UI suggests.
# LEDGER_INSTALL=docker
